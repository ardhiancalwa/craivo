# ==============================================================================
# Cravio - SELA Artisanal Coffee & Bake (.env.example)
# ==============================================================================
# PERINGATAN KEAMANAN:
# 1. Salin berkas ini ke `.env.local` untuk konfigurasi lokal:
#    PowerShell: Copy-Item .env.example .env.local
# 2. JANGAN PERNAH meng-commit berkas `.env` atau `.env.local` ke git repository.
# 3. Variabel TANPA prefix NEXT_PUBLIC_ adalah rahasia server (server-only).
#    Variabel DENGAN prefix NEXT_PUBLIC_ akan dikompilasi ke browser client bundle.
# ==============================================================================

# Environment Name (development | test | staging | production)
APP_ENV="development"

# Database Connection (PostgreSQL - Supabase / Neon via Supavisor)
# DATABASE_URL: Transaction mode pooling (port 6543) dengan ?pgbouncer=true untuk Serverless
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:6543/postgres?pgbouncer=true"

# DIRECT_URL: Direct session mode (port 5432) untuk Prisma CLI migration & introspection
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres"

# Authentication & Session Security (Server-Only)
# Secret key minimum 32 karakter untuk penandatanganan cookie JWT staf via 'jose' (HS256)
JWT_SECRET="ganti-dengan-kunci-rahasia-acak-minimal-32-karakter-3749284729"

# Midtrans Core API (Server-Only & Gateway Config)
# Dapatkan kredensial dari Midtrans Portal -> Settings -> Access Keys (Sandbox Mode)
MIDTRANS_SERVER_KEY="SB-Mid-server-PLACEHOLDER_KEY_DEVELOPMENT"
MIDTRANS_CLIENT_KEY="SB-Mid-client-PLACEHOLDER_KEY_DEVELOPMENT"
MIDTRANS_IS_PRODUCTION="false"

# Scheduled Cron Security (Server-Only)
# Kunci rahasia untuk otorisasi webhook/cron job Vercel Cron
CRON_SECRET="sela_cron_reconcile_secret_2026_secure"

# Disaster Recovery & Backup Encryption (Server-Only)
# Kunci enkripsi AES-256 (minimal 32 karakter) untuk mengamankan data cadangan database & media
BACKUP_ENCRYPTION_KEY="cravio-production-aes-256-backup-secret-key-2026"

# Public Brand & App Configurations (Client-Safe)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_BRAND_NAME="Cravio"
NEXT_PUBLIC_CAFE_NAME="SELA Artisanal Coffee & Bake"
NEXT_PUBLIC_CAFE_SLUG="sela"

